+    /// The canonical form of an event's path. When the path itself no longer exists, the
+    /// nearest ancestor that does is canonicalized and the missing tail is joined back on.
+    fn normalize_event_path(&self, path: &Path) -> Option<PathBuf> {
+        if let Ok(canonical) = self.vfs.canonicalize(path) {
+            return Some(canonical);
+        }
+        let mut tail = Vec::new();
+        let mut current = path;
+        loop {
+            tail.push(current.file_name()?.to_owned());
+            current = current.parent()?;
+            if let Ok(mut base) = self.vfs.canonicalize(current) {
+                for part in tail.iter().rev() {
+                    base.push(part);
+                }
+                return Some(base);
+            }
+        }
+    }
